# Next.js Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# The web app is deployed ONCE (Vercel → app.billingos.dev).
# It talks to both production and sandbox backends automatically
# via the environment switcher — no separate frontend deployments.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. LOCAL DEVELOPMENT  (default — works out of the box with `supabase start`)
# ═════════════════════════════════════════════════════════════════════════════

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
# If running sandbox API locally on a second port (see docs for local sandbox setup):
# NEXT_PUBLIC_SANDBOX_API_URL=http://localhost:3002

# Supabase local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Stripe (test publishable key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...


# ═════════════════════════════════════════════════════════════════════════════
# 2. PRODUCTION + SANDBOX  (Vercel → app.billingos.dev)
#    Set these in the Vercel dashboard under Environment Variables
# ═════════════════════════════════════════════════════════════════════════════
# # Production backend
# NEXT_PUBLIC_API_URL=https://api.billingos.dev
#
# # Sandbox backend (used when user switches to sandbox mode)
# NEXT_PUBLIC_SANDBOX_API_URL=https://sandbox-api.billingos.dev
#
# # Supabase production project (auth always goes to production)
# NEXT_PUBLIC_SUPABASE_URL=https://[prod-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[prod-anon-key]
#
# # Stripe live publishable key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL (all environments)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123.ingest.us.sentry.io/your-project-id
# SENTRY_ORG=billingos
# SENTRY_PROJECT=billingos-web
# SENTRY_AUTH_TOKEN=sntrys_...                   # required for source map uploads
