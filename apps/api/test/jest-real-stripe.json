{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.real\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 180000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^../test/(.*)$": "<rootDir>/../test/$1"
  },
  "modulePathIgnorePatterns": ["<rootDir>/../dist/"],
  "globalSetup": "<rootDir>/../test/real-stripe/global-setup.ts"
}
